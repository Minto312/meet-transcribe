{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "meet-transcribe",
  "version": "0.1.0",
  "identifier": "com.minto312.meet-transcribe",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "meet-transcribe",
        "width": 1240,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "publisher": "Minto312",
    "copyright": "MIT"
  }
}
